# NutriTrack Production Environment Variables
# =============================================
# Copy this file to .env in production and fill in the actual values.
# All variables are required unless marked [OPTIONAL].

# Flask Configuration
# -------------------
# Environment mode (production, development, testing)
FLASK_ENV=production

# Secret key for signing session cookies and CSRF tokens
# CRITICAL: Must be a cryptographically strong random string (32+ bytes hex)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be identical across all instances to maintain session validity across restarts
# If changed, all users will be logged out
SECRET_KEY=your-cryptographic-secret-key-here

# Database Configuration
# ----------------------
# PostgreSQL connection string for production database (Neon Postgres)
# Format: postgresql://user:password@host/database?sslmode=require
# Example: postgresql://user123:abc456@ep-cool-lake-12345.us-east-2.aws.neon.tech/nutritrack?sslmode=require
#
# See CLOUD_SETUP.md Step 4 for how to get this from Neon
# Note: sslmode=require is mandatory for Neon and recommended for all production Postgres
DATABASE_URL=postgresql://user:password@host:5432/nutritrack?sslmode=require

# Authentication
# ---------------
# Enable/disable login requirement
# Set to 'true' for production (requires users to register/login)
# Set to 'false' to disable auth entirely (public access, not recommended for production)
AUTH_ENABLED=true

# AI / Chat Configuration
# ------------------------
# [OPTIONAL] Anthropic API key for Claude chat backend
# If not set, the app falls back to local spaCy NLP parsing
# Get your key at https://console.anthropic.com/
# Users can also provide their own key via localStorage (stored client-side only)
ANTHROPIC_API_KEY=sk-ant-xxxxxx

# Macro Targets (Nutrition Defaults)
# -----------------------------------
# Default daily targets for new users (in grams/kcal)
# These are used when a user has not set custom targets
# Can be overridden per-user via the Settings API
DEFAULT_PROTEIN_TARGET=150
DEFAULT_FAT_TARGET=65
DEFAULT_CARBS_TARGET=250
DEFAULT_CALORIES_TARGET=2200

# Data Seeding (local/CI only, not needed in production)
# -------------------------------------------------------
# [OPTIONAL] Kaggle API credentials for seed_data/seed_meals_kaggle.py
# Only needed if running the data seeding script locally or in CI
# Get credentials at https://www.kaggle.com/settings/account
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Cloud Run Environment (automatically set by Cloud Run, override if needed)
# ---------------------------------------------------------------------------
# [OPTIONAL] Port to listen on (Cloud Run sets this automatically)
# If not set, Flask defaults to 5000
# Cloud Run container entrypoint must respect this: gunicorn --bind 0.0.0.0:$PORT
PORT=8080

# Logging Configuration
# ----------------------
# [OPTIONAL] Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
